# Driver de datos: 'local' (LocalStorage) o 'supabase'
VITE_DATA_DRIVER=local

# Solo necesarias si VITE_DATA_DRIVER=supabase
# URL del proyecto (Supabase → Project Settings → API)
VITE_SUPABASE_URL=
# PUBLISHABLE key (sb_publishable_...). NUNCA uses la secret key aquí.
VITE_SUPABASE_ANON_KEY=

# Solo CI/CD (GitHub Actions → Secrets). NUNCA en .env.local del frontend.
# SUPABASE_SERVICE_ROLE_KEY=
